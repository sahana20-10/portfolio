/* ==========================================================================
   Sahana R — Portfolio
   Pure HTML / CSS / JS build (no Bootstrap)
   ========================================================================== */

/* -------------------- Fonts --------------------
   Poppins — used across headings and body for a clean, premium,
   consistent look across the whole site.
--------------------------------------------------------------------------- */
@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,500;1,600&display=swap');

/* -------------------- Reset -------------------- */
*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

img {
  max-width: 100%;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
}

ul {
  list-style: none;
}

button {
  font: inherit;
  cursor: pointer;
  background: none;
  border: none;
}

input,
textarea {
  font: inherit;
}

svg {
  display: block;
  flex-shrink: 0;
}

/* -------------------- Variables -------------------- */
:root {
  --accent: #8b5cf6;
  --accent-2: #22d3ee;
  --accent-soft: rgba(139, 92, 246, .12);

  --ink: #111827;
  --muted: #667085;
  --card: rgba(255, 255, 255, .86);
  --card-solid: #ffffff;
  --line: rgba(17, 24, 39, .1);
  --bg: #f7f7fb;
  --tag-bg: #f2f4f7;
  --tag-ink: #475467;
  --nav-bg: rgba(247, 247, 251, .82);
  --contact-bg: #111827;

  --font-heading: 'Poppins', 'Segoe UI', sans-serif;
  --font-body: 'Poppins', 'Segoe UI', sans-serif;

  --radius-lg: 24px;
  --radius-md: 16px;
  --radius-sm: 12px;
  --shadow-soft: 0 20px 55px rgba(17, 24, 39, .1);
  --transition: .35s cubic-bezier(.4, 0, .2, 1);
  --transition-fast: .2s ease;
  --transition-slow: .6s cubic-bezier(.4, 0, .2, 1);
}

[data-theme="dark"] {
  --ink: #f8fafc;
  --muted: #aeb7c5;
  --card: rgba(24, 29, 39, .88);
  --card-solid: #171b26;
  --line: rgba(255, 255, 255, .1);
  --bg: #0c1017;
  --tag-bg: #1d2330;
  --tag-ink: #c3c9d4;
  --nav-bg: rgba(12, 16, 23, .82);
  --contact-bg: #05070c;
}

/* -------------------- Base -------------------- */
body {
  font-family: var(--font-body);
  font-weight: 400;
  background: var(--bg);
  color: var(--ink);
  overflow-x: hidden;
  transition: background var(--transition), color var(--transition);
  line-height: 1.6;
  animation: pageFadeIn .8s ease both;
}

@keyframes pageFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes zoomIn {
  from {
    opacity: 0;
    transform: scale(.9);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes floatY {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

@keyframes spinSlow {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes pulseGlow {

  0%,
  100% {
    box-shadow: 0 0 0 0 var(--accent-soft);
  }

  50% {
    box-shadow: 0 0 0 10px transparent;
  }
}

/* generic smooth transitions everywhere */
a,
button,
img,
svg,
.nav-link,
.tag,
.social a,
.btn,
input,
textarea {
  transition: color var(--transition), background var(--transition), border-color var(--transition),
    transform var(--transition), box-shadow var(--transition), opacity var(--transition);
}

::selection {
  background: var(--accent);
  color: #fff;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  border-radius: 20px;
  background: linear-gradient(var(--accent), var(--accent-2));
}

.container {
  width: 100%;
  max-width: 1140px;
  margin-inline: auto;
  padding-inline: 20px;
}

.section {
  padding: 100px 0;
  scroll-margin-top: 90px;
}

.section.pt-0 {
  padding-top: 0;
}

.text-center {
  text-align: center;
}

.section-kicker {
  text-transform: uppercase;
  letter-spacing: .18em;
  font-size: .72rem;
  font-weight: 800;
  color: var(--accent);
  margin-bottom: 10px;
}

.section-title {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: clamp(2.3rem, 5vw, 3.5rem);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin-bottom: 16px;
}

.muted {
  color: var(--muted);
  line-height: 1.8;
}

.muted-center {
  max-width: 720px;
  margin-inline: auto;
}

.glass {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.glass:hover {
  border-color: rgba(139, 92, 246, .35);
}

/* -------------------- Buttons -------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: var(--radius-sm);
  padding: 12px 20px;
  font-weight: 600;
  font-size: .95rem;
  transition: var(--transition);
  white-space: nowrap;
}

.btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(139, 92, 246, .25);
}

.btn:active {
  transform: translateY(-1px);
}

.btn-main {
  background: var(--ink);
  color: var(--bg);
}

[data-theme="dark"] .btn-main {
  color: #0c1017;
}

.btn-main:hover {
  background: var(--accent);
  color: #fff;
}

.btn-soft {
  border: 1px solid var(--line);
  color: var(--ink);
}

.btn-soft:hover {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

.btn-icon {
  width: 20px;
  height: 20px;
  transition: transform var(--transition);
}

.btn:hover .btn-icon {
  transform: translate(3px, -3px);
}

/* -------------------- Header / Navbar -------------------- */
#header {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 1000;
}

.navbar {
  padding: 16px 0;
  background: var(--nav-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: box-shadow var(--transition);
   background:var(--transition);
}

.navbar.scrolled {
  box-shadow: 0 10px 35px rgba(17, 24, 39, .08);
}

.navbar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
/* =========================================================
   NAVBAR
   ========================================================= */

.nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  background: transparent;
  border-radius: var(--radius-sm);
  color: var(--ink);
  cursor: pointer;
  flex-shrink: 0;
  transition: var(--transition);
}

.nav-toggle:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

.nav-toggle svg {
  width: 22px;
  height: 22px;
  transition: transform var(--transition);
}

.nav-toggle[aria-expanded="true"] svg {
  transform: rotate(90deg);
}


/* =========================================================
   NAV MENU
   ========================================================= */

.nav-menu {
  display: flex;
  align-items: center;
  gap: 4px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-link {
  position: relative;
  display: inline-block;
  color: var(--tag-ink);
  font-weight: 500;
  font-size: 0.95rem;
  padding: 8px 14px;
  border-radius: 999px;
  text-decoration: none;
  white-space: nowrap;
  transition: var(--transition);
}

.nav-link::after {
  content: '';
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 3px;
  height: 2px;
  border-radius: 2px;
  background: linear-gradient(
    90deg,
    var(--accent),
    var(--accent-2)
  );
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition);
}

.nav-link:hover,
.nav-link.active {
  color: var(--accent);
  background: var(--accent-soft);
  transform: translateY(-1px);
}

.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}


/* =========================================================
   THEME BUTTON
   ========================================================= */

.theme-btn {
  width: 42px;
  height: 42px;
  min-width: 42px;
  display: grid;
  place-items: center;

  border: 1px solid var(--line);
  background: transparent;
  border-radius: var(--radius-sm);

  margin-left: 14px;
  color: var(--ink);

  cursor: pointer;
  flex-shrink: 0;

  transition: var(--transition);
}

.theme-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: rotate(15deg) scale(1.08);
}

.theme-btn svg {
  width: 19px;
  height: 19px;

  transition:
    transform 0.5s cubic-bezier(.4, 0, .2, 1),
    opacity 0.3s ease;
}

.theme-btn .icon-sun {
  display: none;
}

[data-theme="dark"] .theme-btn .icon-moon {
  display: none;
}

[data-theme="dark"] .theme-btn .icon-sun {
  display: block;
  animation: zoomIn 0.4s ease;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .nav-link {
    font-size: 0.9rem;
    padding: 8px 10px;
  }

  .nav-links {
    gap: 3px;
  }

  .theme-btn {
    margin-left: 8px;
  }
}


/* =========================================================
   MOBILE NAVIGATION
   ========================================================= */

@media (max-width: 768px) {

  /* SHOW MOBILE MENU BUTTON */
  .nav-toggle {
    display: flex !important;
    position: relative;
    z-index: 1002;
  }

  /* Keep navbar items on one line */
  .navbar,
  .nav-container,
  .nav-inner {
    position: relative;
  }

  /* Hide desktop menu initially */
  .nav-menu {
    position: absolute;

    top: calc(100% + 10px);
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;
    align-items: stretch;

    padding: 10px;

    background: var(--surface, #ffffff);
    border: 1px solid var(--line);
    border-radius: 16px;

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-10px);

    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;

    z-index: 1001;
  }

  /* OPEN MENU */
  .nav-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Mobile links */
  .nav-links {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: stretch;

    gap: 4px;
  }

  .nav-link {
    width: 100%;
    display: block;

    padding: 12px 14px;

    border-radius: 10px;

    font-size: 0.95rem;
  }

  .nav-link::after {
    display: none;
  }

  .nav-link:hover,
  .nav-link.active {
    transform: none;
  }

  /* Theme button inside mobile menu */
  .theme-btn {
    width: 100%;
    height: 42px;

    margin: 6px 0 0;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;
  }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .nav-toggle {
    width: 40px;
    height: 40px;
  }

  .nav-toggle svg {
    width: 21px;
    height: 21px;
  }

  .nav-menu {
    top: calc(100% + 8px);
    padding: 8px;
    border-radius: 14px;
  }

  .nav-link {
    padding: 11px 12px;
    font-size: 0.9rem;
  }
}


/* =========================================================
   VERY SMALL SCREENS
   ========================================================= */

@media (max-width: 360px) {

  .nav-toggle {
    width: 38px;
    height: 38px;
  }

  .nav-menu {
    left: 0;
    right: 0;
  }

  .nav-link {
    font-size: 0.88rem;
  }
}

.brand {
  font-family: var(--font-heading);
  font-weight: 700;
  letter-spacing: -.01em;
  font-size: 1.35rem;
  color: var(--ink);
  transition: var(--transition);
}

.brand:hover {
  transform: translateY(-2px);
}

.brand span {
  color: var(--accent);
}


[data-theme="dark"] .theme-btn .icon-moon {
  display: none;
}

[data-theme="dark"] .theme-btn .icon-sun {
  display: block;
  animation: zoomIn .4s ease;
}

/* -------------------- Hero -------------------- */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 140px 0 80px;
  background:
    radial-gradient(circle at 80% 20%, rgba(139, 92, 246, .14), transparent 32%),
    radial-gradient(circle at 15% 80%, rgba(34, 211, 238, .12), transparent 30%);
}

.hero .container {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  align-items: center;
  gap: 50px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border: 1px solid rgba(139, 92, 246, .25);
  border-radius: 999px;
  color: #6941c6;
  background: var(--card-solid);
  font-size: .86rem;
  font-weight: 600;
  animation: fadeUp .7s ease both;
}

[data-theme="dark"] .eyebrow {
  color: #c4b5fd;
}

.eyebrow svg {
  width: 15px;
  height: 15px;
  animation: spinSlow 6s linear infinite;
}

.hero h1 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: clamp(3rem, 7vw, 5.6rem);
  line-height: 1.02;
  letter-spacing: -.02em;
  margin: 22px 0;
  animation: fadeUp .7s ease .1s both;
}

.hero h1 em {
  font-style: italic;
  color: var(--accent);
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero .lead {
  font-size: 1.12rem;
  line-height: 1.8;
  color: var(--muted);
  max-width: 620px;
  animation: fadeUp .7s ease .2s both;
}

.hero-meta {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
  color: var(--tag-ink);
  font-size: .92rem;
  margin: 25px 0;
  animation: fadeUp .7s ease .3s both;
}

.hero-meta li {
  display: flex;
  align-items: center;
  gap: 6px;
  transition: var(--transition);
}

.hero-meta li:hover {
  color: var(--accent);
  transform: translateX(3px);
}

.hero-meta svg {
  width: 16px;
  height: 16px;
  color: var(--accent);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  animation: fadeUp .7s ease .4s both;
}

.hero-photo {
  position: relative;
  max-width: 430px;
  margin: auto;
  animation: zoomIn .8s ease .2s both, floatY 6s ease-in-out 1s infinite;
}

.hero-photo::after {
  position: absolute;
  width: 100px;
  height: 100px;
  border-radius: 24px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  right: -20px;
  bottom: -20px;
  z-index: -1;
  transition: var(--transition-slow);
}

.hero-photo:hover::after {
  transform: rotate(12deg) scale(1.1);
}

.hero-photo img {
  width: 100%;
  aspect-ratio: 4/5;
  object-fit: cover;
  object-position: center top;
  border-radius: 32px;
  box-shadow: 0 30px 70px rgba(17, 24, 39, .18);
  transition: var(--transition-slow);
}

.hero-photo:hover img {
  transform: scale(1.03) rotate(-1deg);
  box-shadow: 0 35px 80px rgba(17, 24, 39, .28);
}

/* -------------------- About -------------------- */
.about-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  align-items: center;
  gap: 50px;
}

.about-photo {
  width: 100%;
  height:660px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  transition: var(--transition-slow);
}

.about-photo:hover {
  transform: scale(1.02);
  box-shadow: var(--shadow-soft);
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin-top: 26px;
  max-width: 420px;
}

.stat {
  padding: 18px;
}

.stat strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 600;
}

.stat span {
  font-size: .85rem;
  color: var(--muted);
}

/* -------------------- Timeline (Education / Experience) -------------------- */
.timeline {
  position: relative;
  margin-top: 30px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 14px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(var(--accent), var(--accent-2));
  opacity: .3;
}

.timeline-card {
  position: relative;
  margin-left: 45px;
  padding: 25px;
}

.timeline-card + .timeline-card {
  margin-top: 20px;
}

.timeline-card::before {
  content: '';
  position: absolute;
  left: -38px;
  top: 30px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 6px var(--accent-soft);
}

.timeline-card .date {
  font-size: .8rem;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.timeline-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.2rem;
  margin: 8px 0;
}

.timeline-card p {
  color: var(--muted);
  line-height: 1.7;
}

.timeline-card:hover,
.skill-card:hover,
.project-card:hover,
.cert-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-soft);
}

.timeline-card:hover::before {
  transform: scale(1.2);
}

.timeline-card::before {
  transition: transform var(--transition);
}

/* -------------------- Skills -------------------- */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 36px;
}

.skill-card {
  padding: 24px;
}

.skill-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: var(--accent-soft);
  color: var(--accent);
  margin-bottom: 14px;
  transition: var(--transition);
}

.skill-card:hover .skill-icon {
  background: var(--accent);
  color: #fff;
  transform: rotate(-8deg) scale(1.1);
}

.skill-icon svg {
  width: 22px;
  height: 22px;
}

.skill-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  margin-bottom: 7px;
}

.skill-card p {
  font-size: .88rem;
  color: var(--muted);
  line-height: 1.65;
}

/* -------------------- Projects -------------------- */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  align-items: stretch;
  gap: 20px;
  margin-top: 36px;
}

.project-card {
  width: 100%;
  height: 100%;
  min-height: 320px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.project-top {
  padding: 27px 27px 18px;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.project-top .desc {
  flex-grow: 0;
}

.project-number {
  font-size: .75rem;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: .1em;
}

.project-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.35rem;
  margin: 8px 0;
}

.project-card .desc {
  color: var(--muted);
  line-height: 1.7;
  font-size: .9rem;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.tag {
  display: inline-block;
  padding: 6px 10px;
  background: var(--tag-bg);
  border-radius: 8px;
  font-size: .72rem;
  color: var(--tag-ink);
  transition: var(--transition);
}

.tag:hover {
  background: var(--accent);
  color: #fff;
  transform: translateY(-2px);
}

.project-footer {
  padding: 0 27px 27px;
}

.project-footer a,
.project-footer .badge-text {
  font-weight: 700;
  color: var(--ink);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: .9rem;
}

.project-footer .badge-text {
  color: var(--muted);
  font-weight: 500;
}

.project-footer a svg {
  width: 15px;
  height: 15px;
}

.project-footer a:hover {
  color: var(--accent);
}

/* -------------------- Certifications -------------------- */
.certs-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin-top: 30px;
}

.cert-card {
  padding: 24px;
}

.cert-card .year {
  color: var(--accent);
  font-size: .78rem;
  font-weight: 700;
}

.cert-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  margin: 8px 0;
}

.cert-card p {
  color: var(--muted);
  font-size: .88rem;
}

/* -------------------- Contact -------------------- */
.contact-box {
  padding: 46px;
  background: var(--contact-bg);
  color: #fff;
  overflow: hidden;
  position: relative;
  border-radius: var(--radius-lg);
}

.contact-box::after {
  content: '';
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: rgba(139, 92, 246, .22);
  right: -100px;
  top: -120px;
  filter: blur(30px);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 40px;
  position: relative;
  z-index: 1;
}

.contact-box .section-kicker {
  color: #c4b5fd;
}

.contact-box .section-title {
  color: #fff;
}

.contact-box .muted {
  color: #c5cad3;
}

.contact-links {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
  padding: 8px 0;
  font-size: .96rem;
}

.contact-link svg {
  width: 17px;
  height: 17px;
  color: var(--accent-2);
}

a.contact-link:hover {
  color: #c4b5fd;
}

.contact-grid h4 {
  font-family: var(--font-heading);
  font-weight: 600;
  margin-bottom: 14px;
  font-size: 1.1rem;
}

.social {
  display: flex;
  gap: 10px;
}

.social a {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 12px;
  display: grid;
  place-items: center;
  color: #fff;
  transition: var(--transition);
}

.social a svg {
  width: 19px;
  height: 19px;
  transition: transform var(--transition);
}

.social a:hover svg {
  transform: scale(1.15) rotate(-6deg);
}

.social a:hover {
  background: var(--accent);
  border-color: var(--accent);
  transform: translateY(-4px);
}

.language-pill {
  display: inline-flex;
  gap: 7px;
  flex-wrap: wrap;
}

.language-pill span {
  padding: 7px 12px;
  background: rgba(255, 255, 255, .06);
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 999px;
  font-size: .78rem;
  color: #e4e7ec;
}

.declaration {
  margin-top: 24px;
  font-size: .82rem;
  color: #c5cad3;
  line-height: 1.7;
}

.declaration strong {
  color: #fff;
}

/* -------------------- Footer -------------------- */
footer {
  padding: 32px 0;
  color: var(--muted);
  font-size: .88rem;
  border-top: 1px solid var(--line);
}

footer .container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
}

/* -------------------- Back to top -------------------- */
#backToTopButton {
  position: fixed;
  right: 22px;
  bottom: 22px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--ink);
  color: var(--bg);
  box-shadow: var(--shadow-soft);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transform: translateY(16px) scale(.9);
  transition: var(--transition), visibility 0s linear .35s;
}

[data-theme="dark"] #backToTopButton {
  color: #0c1017;
}

#backToTopButton.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
  transition: var(--transition), visibility 0s linear 0s;
}

#backToTopButton:hover {
  background: var(--accent);
  color: #fff;
  transform: translateY(-4px) scale(1.05);
}

#backToTopButton svg {
  width: 20px;
  height: 20px;
}

/* -------------------- Scroll reveal -------------------- */
[data-reveal] {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .7s ease, transform .7s ease;
}

[data-reveal].in-view {
  opacity: 1;
  transform: translateY(0);
}

[data-reveal="zoom"] {
  transform: scale(.94);
}

[data-reveal="zoom"].in-view {
  transform: scale(1);
}

/* Staggered entrance for grid / list items */
.skills-grid [data-reveal]:nth-child(1),
.projects-grid [data-reveal]:nth-child(1),
.certs-grid [data-reveal]:nth-child(1),
.timeline [data-reveal]:nth-child(1) {
  transition-delay: .05s;
}

.skills-grid [data-reveal]:nth-child(2),
.projects-grid [data-reveal]:nth-child(2),
.certs-grid [data-reveal]:nth-child(2),
.timeline [data-reveal]:nth-child(2) {
  transition-delay: .15s;
}

.skills-grid [data-reveal]:nth-child(3),
.projects-grid [data-reveal]:nth-child(3),
.certs-grid [data-reveal]:nth-child(3) {
  transition-delay: .25s;
}

.skills-grid [data-reveal]:nth-child(4),
.certs-grid [data-reveal]:nth-child(4) {
  transition-delay: .35s;
}

.skills-grid [data-reveal]:nth-child(5) {
  transition-delay: .45s;
}

.skills-grid [data-reveal]:nth-child(6) {
  transition-delay: .55s;
}

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: .001s !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001s !important;
  }

  [data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .hero-photo {
    animation: none;
  }
}

/* -------------------- Responsive -------------------- */
@media (max-width: 991px) {

  .hero .container,
  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .hero-photo {
    order: -1;
    max-width: 320px;
  }

  .about-photo {
    height: 420px;
  }

  .skills-grid,
  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 767px) {
  .section {
    padding: 72px 0;
  }

  .hero {
    padding: 110px 0 60px;
    min-height: auto;
  }

  .hero h1 {
    font-size: 2.9rem;
  }

  .nav-toggle {
    display: grid;
    place-items: center;
  }

  .nav-menu {
    position: fixed;
    inset: 74px 16px auto 16px;
    flex-direction: column;
    align-items: stretch;
    background: var(--card-solid);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 14px;
    box-shadow: var(--shadow-soft);
    transform: translateY(-12px);
    opacity: 0;
    pointer-events: none;
    transition: var(--transition);
  }

  .nav-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-links {
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
  }

  .nav-link {
    padding: 12px 14px;
  }

  .theme-btn {
    margin: 10px 0 0;
    align-self: flex-start;
  }

  .skills-grid,
  .projects-grid,
  .certs-grid,
  .about-stats {
    grid-template-columns: 1fr;
  }

  .contact-box {
    padding: 30px 22px;
  }

  .project-card {
    min-height: 0;
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-actions .btn {
    justify-content: center;
  }
}

/* -------------------- Extra-small phones -------------------- */
@media (max-width: 480px) {
  .container {
    padding-inline: 16px;
  }

  .hero {
    padding: 100px 0 50px;
  }

  .hero h1 {
    font-size: 2.3rem;
  }

  .hero .lead {
    font-size: 1rem;
  }

  .hero-meta {
    gap: 14px;
    font-size: .85rem;
  }

  .hero-photo {
    max-width: 260px;
  }

  .section-title {
    font-size: 1.9rem;
  }


  .stat {
    padding: 14px;
  }

  .stat strong {
    font-size: 1.25rem;
  }

  .timeline-card,
  .skill-card,
  .cert-card {
    padding: 18px;
  }

  .project-top,
  .project-footer {
    padding-left: 20px;
    padding-right: 20px;
  }

  .contact-box {
    padding: 14px 13px;
  }

  .social a {
    width: 38px;
    height: 38px;
  }

  #backToTopButton {
    right: 14px;
    bottom: 14px;
    width: 42px;
    height: 42px;
  }
}
/* =========================================================
   MOBILE + CONTACT + PROJECT FIXES
   ========================================================= */

/* ---------- Contact email: prevent mobile overflow ---------- */
.contact-link {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.contact-link svg {
  width: 17px;
  height: 17px;
  min-width: 17px;
  flex: 0 0 17px;
}


/* ---------- Project footer icons ---------- */

/* Normal "Visit Website" arrow */
.project-footer a svg {
  width: 15px;
  height: 15px;
  min-width: 15px;
  flex: 0 0 15px;
}

/* Academic / Personal Project graduation icon */
.project-footer .badge-text {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.project-footer .badge-text svg {
  width: 20px !important;
  height: 20px !important;
  min-width: 20px;
  min-height: 20px;
  max-width: 20px;
  max-height: 20px;
  flex: 0 0 20px;
}


/* ---------- Mobile project cards ---------- */
@media (max-width: 767px) {

  .projects-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .project-card {
    min-height: 0;
    height: auto;
  }

  .project-top {
    padding: 22px 20px 16px;
  }

  .project-footer {
    padding: 0 20px 22px;
  }

  /* Keep the graduation icon small */
  .project-footer .badge-text svg {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px;
    max-width: 20px;
  }

  .project-footer .badge-text {
    font-size: .85rem;
    line-height: 1.4;
  }

  /* Prevent long project text from overflowing */
  .project-card .desc {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  /* Tags stay inside the card */
  .tag-list {
    max-width: 100%;
  }

  .tag {
    white-space: nowrap;
  }
}


/* ---------- Extra-small phones ---------- */
@media (max-width: 480px) {

  .contact-link {
    font-size: .88rem;
    line-height: 1.5;
    align-items: flex-start;
  }

  .contact-link svg {
    margin-top: 4px;
  }

  .project-top {
    padding: 20px 18px 14px;
  }

  .project-footer {
    padding: 0 18px 20px;
  }

  .project-footer .badge-text {
    font-size: .8rem;
  }

  .project-footer .badge-text svg {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px;
    max-width: 18px;
    flex-basis: 18px;
  }
}
